{
  "name": "tabby-keep-scrollback",
  "version": "0.1.0",
  "description": "Tabby plugin: clearing the screen pushes it into scrollback instead of erasing it, and session requests to wipe scrollback (ESC[3J) are ignored.",
  "keywords": [
    "tabby-plugin"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@angular/core": "^15.2.10",
    "@xterm/headless": "5.5.0",
    "rxjs": "^7.8.2",
    "ts-loader": "^9.6.2",
    "typescript": "~5.4.5",
    "vitest": "^2.1.9",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1",
    "zone.js": "^0.13.3"
  }
}
