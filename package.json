{
  "name": "tabby-keep-scrollback",
  "version": "0.2.2",
  "description": "Tabby plugin: clear and reset push the screen into scrollback instead of erasing it, so you can still scroll up. Programs can't wipe your scrollback.",
  "keywords": [
    "tabby-plugin"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "author": "RevanMardagh",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/RevanMardagh/tabby-keep-scrollback#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RevanMardagh/tabby-keep-scrollback.git"
  },
  "bugs": {
    "url": "https://github.com/RevanMardagh/tabby-keep-scrollback/issues"
  },
  "devDependencies": {
    "@angular/common": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@xterm/headless": "5.5.0",
    "rxjs": "^7.8.2",
    "ts-loader": "^9.6.2",
    "typescript": "~5.4.5",
    "vitest": "^2.1.9",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1",
    "zone.js": "^0.13.3"
  }
}
